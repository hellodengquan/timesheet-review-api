# ============================================================
#  timesheet-review-api  环境变量模板
#  使用方式：复制本文件为 .env，按需修改。
#  cp .env.example .env
# ============================================================

# ----------------------------------------------------------
#  1. 数据库路径（SQLite 文件位置）
#     - 本地开发: 相对路径即可，如 ./timesheet.db
#     - Docker / 生产: 必须位于挂载卷内，推荐 /data/timesheet.db
#     - 测试/一次性运行: 设为 :memory: 可获得内存数据库
# ----------------------------------------------------------
DB_PATH=./timesheet.db

# ----------------------------------------------------------
#  2. uvicorn 服务监听
#     HOST     : 绑定地址，容器内需 0.0.0.0 才能对外暴露
#     PORT     : 容器内端口，与 Dockerfile EXPOSE 保持 8000
#     HOST_PORT: docker-compose 宿主机映射端口（可覆盖 8000）
#     WORKERS  : uvicorn worker 数，建议 = CPU 核数 * 2 + 1
# ----------------------------------------------------------
HOST=0.0.0.0
PORT=8000
HOST_PORT=8000
WORKERS=2

# ----------------------------------------------------------
#  3. 运行时行为
#     APP_ENV   : 环境标签 [development | staging | production]
#     DEBUG     : 开发模式调试开关 [true | false]
#     LOG_LEVEL : 日志级别 [debug | info | warning | error | critical]
#     TZ        : 时区，异常工时判断涉及日期，请保持与办公时区一致
# ----------------------------------------------------------
APP_ENV=development
DEBUG=false
LOG_LEVEL=info
TZ=Asia/Shanghai

# ----------------------------------------------------------
#  4. 业务阈值（可根据公司考勤制度调整）
#     ANOMALY_HOURS_THRESHOLD : 当日累计工时超过该值 => 自动标记 anomaly
#     ANOMALY_ENABLE_HOLIDAY  : 法定假日报工是否自动 anomaly [true | false]
# ----------------------------------------------------------
ANOMALY_HOURS_THRESHOLD=12
ANOMALY_ENABLE_HOLIDAY=true

# ----------------------------------------------------------
#  5. Docker build 内部变量（一般无需修改）
# ----------------------------------------------------------
BUILDKIT_INLINE_CACHE=1
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1
